% \begin{macro}{\@@_image_fill_area:nnnnnnnn}
%   Scale an image to fill a rectangular area, clipping overlapping parts. The
%   image is centred in the area then offset by the supplied additional
%   horizontal and vertical offsets.
%   \begin{arguments}
%     \item $x$-coordinate of lower left of image area
%     \item $y$-coordinate of lower left of image area
%     \item $x$-coordinate of upper right of image area
%     \item $y$-coordinate of upper right of image area
%     \item Additional horizontal offset of placed image
%     \item Additional vertical offset of placed image
%     \item Alt text for image
%     \item Image file name
%   \end{arguments}
%    \begin{macrocode}
\box_new:N    \l_@@_image_box
\coffin_new:N \l_@@_image_coffin
\dim_new:N    \l_@@_image_viewport_width_dim
\dim_new:N    \l_@@_image_viewport_height_dim
\fp_new:N     \l_@@_image_ratio_fp
\fp_new:N     \l_@@_image_viewport_ratio_fp
\cs_new_protected:Nn \@@_image_fill_area:nnnnnnnn
  {
    \dim_set:Nn \l_@@_image_viewport_width_dim
      { \dim_abs:n { #3 - #1 } }
    \dim_set:Nn \l_@@_image_viewport_height_dim
      { \dim_abs:n { #4 - #2 } }
    \hbox_set:Nn \l_@@_image_box
      {
        \includegraphics [ #7 ] {#8}
      }
    \fp_set:Nn \l_@@_image_ratio_fp
      {
        \dim_ratio:nn
          { \box_wd:N \l_@@_image_box }
          { \box_ht:N \l_@@_image_box }
      }
    \fp_set:Nn \l_@@_image_viewport_ratio_fp
      {
        \dim_ratio:nn
          { \l_@@_image_viewport_width_dim }
          { \l_@@_image_viewport_height_dim }
      }
    \fp_compare:nNnTF
      { \l_@@_image_ratio_fp } > { \l_@@_image_viewport_ratio_fp }
      {
        \box_resize_to_ht:Nn \l_@@_image_box
          { \l_@@_image_viewport_height_dim }
      }
      {
        \box_resize_to_wd:Nn \l_@@_image_box
          { \l_@@_image_viewport_width_dim }
      }
    \hcoffin_set:Nn \l_@@_image_coffin
      { \box_use_drop:N \l_@@_image_box }
    \draw_begin:
      \bool_set_false:N \l_draw_bb_update_bool
      \draw_path_rectangle:nn
        { #1 , #2 }
        {
          \l_@@_image_viewport_width_dim ,
          \l_@@_image_viewport_height_dim
        }
      \draw_path_use_clear:n { clip }
      \put ( #1 , #2 )
        {
          \coffin_typeset:Nnnnn \l_@@_image_coffin
            { hc } { vc }
            { #5 + \l_@@_image_viewport_width_dim / 2 }
            { #5 + \l_@@_image_viewport_height_dim / 2 }
        }
    \draw_end:
  }
%    \end{macrocode}
% \end{macro}
