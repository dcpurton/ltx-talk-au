          }
          {
            \@@_grid_x:nn { r } {#3} - \@@_grid_x:nn { l } {#2}
          }
      }
  }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\@@_grid_dy:nnn}
%   Calculate the distance between the bottom side of |#2| and the top side of
%   |#3| into points. If |#1| is |true| then calculate the distance between
%   the centre of the cells.
%   \begin{arguments}
%     \item Set to |true| to calculate the distance from the centre of the
%       cells
%     \item Bottom $y$ grid cell number (1–18 for std layout and 1–12 for
%       cover layout)
%     \item Top $y$ grid cell number (1–18 for std layout and 1–12 for cover
%     layout)
%   \end{arguments}
%    \begin{macrocode}
\cs_new:Nn \@@_grid_dy:nnn
  {
    \dim_abs:n
      {
        \bool_if:nTF {#1}
          {
            \@@_grid_y:nn { c } {#3} - \@@_grid_y:nn { c } {#2}
          }
          {
            \@@_grid_y:nn { t } {#3} - \@@_grid_y:nn { b } {#2}
          }
      }
  }
