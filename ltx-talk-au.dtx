        \cs_gset_protected:ce
          { @@_frame_image_ \l_@@_frame_image_slot_str _draw: }
          {
            \exp_not:N
              \UseTemplate { frame-image } { talkau } { }
                {
                  , slot = \l_@@_frame_image_slot_str
                  , #2
                  , image-filename = #3
                }
          }
      }
