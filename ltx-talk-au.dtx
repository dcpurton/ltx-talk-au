%       template)
%     \item Section heading text
%   \end{arguments}
%    \begin{macrocode}
\keys_define:nn { talk / heading }
  {
    , unknown .code:n =
  }
\RenewDocumentCommand \section
  { s D <> { all } = { shorttitle } O {#4} m }
  {
    \bool_if:NF \l__talk_frame_bool
      {
        \__talk_if_overlay:nT {#2}
          {
            \use:c { __talk_head_1:Nnn } #1 {#3} {#4}
            \UseTemplate { section-frame } { talkau } { } {#3}
          }
      }
  }
