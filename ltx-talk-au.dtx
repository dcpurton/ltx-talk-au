% \subsection{Colours}
%
% Define the Adelaide University brand colours: Dark Blue, North Terrace
% Purple, Bright Blue and South Coast Limestone.
%
%    \begin{macrocode}
\DeclareColor { darkblue }   [ RGB ] {  20 ,  15 ,  80 }
\DeclareColor { purple }     [ RGB ] { 131 , 107 , 255 }
\DeclareColor { brightblue } [ RGB ] {  20 ,  72 , 255 }
\DeclareColor { limestone }  [ RGB ] { 248 , 239 , 224 }
\prop_new:N \g_@@_theme_background_prop
\prop_new:N \g_@@_theme_structure_prop
\prop_new:N \g_@@_theme_alert_prop
\prop_new:N \g_@@_theme_example_prop
\tl_new:N   \l_@@_colour_background_tl
\tl_new:N   \l_@@_colour_structure_tl
\tl_new:N   \l_@@_colour_alert_tl
\tl_new:N   \l_@@_colour_example_tl
\keys_define:nn { talkau / colours }
  {
    , background .tl_set:N         = \l_@@_colour_background_tl
    , background .value_required:n = true
    , background .initial:n        = white
    , structure  .tl_set:N         = \l_@@_colour_structure_tl
    , structure  .value_required:n = true
    , strucuture .initial:n        = darkblue
    , alert      .tl_set:N         = \l_@@_colour_alert_tl
    , alert      .value_required:n = true
    , alert      .initial:n        = brightblue
    , example    .tl_set:N         = \l_@@_colour_example_tl
    , example    .value_required:n = true
    , example    .initial:n        = purple
  }
%    \end{macrocode}
%
% \begin{macro}{\@@_theme_define:nn}
%   Save a set of colours under specified theme name.
%   \begin{arguments}
%     \item Theme name.
%     \item List of key-value items specifying |background|, |structure|,
%       |alert| and |example| colours.
%   \end{arguments}
%    \begin{macrocode}
\cs_new_protected:Nn \@@_theme_define:nn
  {
    \keys_set:nn { talkau / colours } {#2}
    \prop_gput:NnV \g_@@_theme_background_prop
      {#1} \l_@@_colour_background_tl
    \prop_gput:NnV \g_@@_theme_structure_prop
      {#1} \l_@@_colour_structure_tl
    \prop_gput:NnV \g_@@_theme_alert_prop
      {#1} \l_@@_colour_alert_tl
    \prop_gput:NnV \g_@@_theme_example_prop
      {#1} \l_@@_colour_example_tl
  }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\@@_theme_select:n}
%   Select a previous defined colour theme.
%   \begin{arguments}
%     \item Name of previously defined colour theme.
%   \end{arguments}
%    \begin{macrocode}
\cs_new_protected:Nn \@@_theme_select:n
  {
    \exp_args:Nne \DeclareColor
      { background }
      { \prop_item:Nn \g_@@_theme_background_prop {#1} }
    \exp_args:Nne \DeclareColor
      { structure }
      { \prop_item:Nn \g_@@_theme_structure_prop {#1} }
    \exp_args:Nne \DeclareColor
      { alert }
      { \prop_item:Nn \g_@@_theme_alert_prop {#1} }
    \exp_args:Nne \DeclareColor
      { example }
      { \prop_item:Nn \g_@@_theme_example_prop {#1} }
    \color { structure }
  }
%    \end{macrocode}
% \end{macro}
%
% Define some standard colour themes.
%
%    \begin{macrocode}
\@@_theme_define:nn { std }
  {
    , background = white
    , structure  = darkblue
    , alert      = brightblue
    , example    = purple
  }
\@@_theme_define:nn { darkblue }
  {
    , background = darkblue
    , structure  = white
    , alert      = purple
    , example    = limestone
  }
\@@_theme_define:nn { limestone }
  {
    , background = limestone
    , structure  = darkblue
    , alert      = brightblue
    , example    = purple
  }
\@@_theme_define:nn { brightblue }
  {
    , background = brightblue
    , structure  = white
    , alert      = limestone
    , example    = purple
  }
\@@_theme_define:nn { purple }
  {
    , background = purple!20
    , structure  = darkblue
    , alert      = purple
    , example    = brightblue
  }
\@@_theme_select:n { std }
%    \end{macrocode}
%
% \begin{macro}{\TalkAUThemeDefine, \TalkAUThemeSelect}
%   \LaTeX{} interfaces for \cs{@@_theme_define:nn} and \cs{@@_theme_select:n}.
%    \begin{macrocode}
\NewDocumentCommand \TalkAUThemeDefine { m m }
  {
    \@@_theme_define:nn {#1} {#2}
  }
\NewDocumentCommand \TalkAUThemeSelect { m }
  {
    \@@_theme_select:n {#1}
  }
%    \end{macrocode}
% \end{macro}
