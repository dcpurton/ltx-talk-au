% \subsection{Grid}
%
% Adelaide University slides use a grid system for laying out slide elements.
% The grid is built around the page size and logo dimensions. Calculate the
% various grid dimensions.
%
%    \begin{macrocode}
\dim_const:Nn \c_@@_grid_column_sep_dim    { 0.010417 \paperwidth }
\dim_const:Nn \c_@@_margin_footer_dim { 0.038372 \paperheight }
\dim_const:Nn \c_@@_margin_cover_dim  { 2 \c_@@_margin_footer_dim }
\dim_const:Nn \c_@@_page_width_dim
  { \paperwidth - 2 \c_@@_margin_cover_dim }
\dim_const:Nn \c_@@_page_height_cover_dim
  { \paperheight - 2 \c_@@_margin_cover_dim }
\dim_const:Nn \c_@@_page_height_std_dim
  {
    \paperheight -
    \c_@@_margin_cover_dim -
    \c_@@_margin_footer_dim
  }
\dim_const:Nn \c_@@_grid_column_width_dim
  {
    0.083333 \c_@@_page_width_dim -
    0.91667 \c_@@_grid_column_sep_dim
  }
\dim_const:Nn \c_@@_grid_row_cover_dim
  { 0.083333 \c_@@_page_height_cover_dim }
\dim_const:Nn \c_@@_grid_row_std_dim
  { 0.055556 \c_@@_page_height_std_dim }
%    \end{macrocode}
%
%    \begin{macrocode}
\geometry
  {
    , tmargin    = \c_@@_margin_cover_dim +
                   3 \c_@@_grid_row_std_dim
    , bmargin    = \c_@@_margin_footer_dim +
                   2 \c_@@_grid_row_std_dim
    , lmargin    = \c_@@_margin_cover_dim
    , rmargin    = \c_@@_margin_cover_dim
    , footskip   = 2 \c_@@_grid_row_std_dim
    , headheight = \c_@@_margin_cover_dim +
                   \c_@@_grid_row_std_dim
    , headsep    = 2 \c_@@_grid_row_std_dim
  }
%    \end{macrocode}
%
% Code for drawing the grid over a slide.
%
%    \begin{macrocode}
\RequirePackage { l3draw }
%    \end{macrocode}
%
% \begin{macro}{\@@_grid_draw_set_up:}
%   Common grid drawing set up code.
%    \begin{macrocode}
\cs_new_protected:Nn \@@_grid_draw_set_up:
  {
      \bool_set_false:N \l_draw_bb_update_bool
      \draw_set_linewidth:n { 0.4pt }
      \color_select:n { black!20 }
  }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\@@_grid_draw_vertical_cover:}
%   Draw vertical grid lines for cover layout slides.
%    \begin{macrocode}
\cs_new_protected:Nn \@@_grid_draw_vertical_cover:
  {
    \draw_begin:
      \@@_grid_draw_set_up:
      \draw_transform_shift:n
        {
          \c_@@_margin_cover_dim ,
          \c_@@_margin_cover_dim - \paperheight
        }
      \draw_path_grid:nnnn
        { \c_@@_grid_column_width_dim + \c_@@_grid_column_sep_dim }
        { \c_@@_page_height_cover_dim }
        { 0pt , 0pt }
        {
          \c_@@_page_width_dim -
          \c_@@_grid_column_width_dim ,
          \c_@@_page_height_cover_dim
        }
      \draw_transform_shift:n
        { \c_@@_grid_column_width_dim , 0pt }
      \draw_path_grid:nnnn
        { \c_@@_grid_column_width_dim + \c_@@_grid_column_sep_dim }
        { \c_@@_page_height_std_dim }
        { 0pt , 0pt }
        {
          \c_@@_page_width_dim -
          \c_@@_grid_column_width_dim ,
          \c_@@_page_height_cover_dim
        }
      \draw_path_use_clear:n { stroke }
    \draw_end:
  }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\@@_grid_draw_vertical_std:}
%   Draw vertical grid lines for standard slide layouts.
%    \begin{macrocode}
\cs_new_protected:Nn \@@_grid_draw_vertical_std:
  {
    \draw_begin:
      \@@_grid_draw_set_up:
      \draw_transform_shift:n
        {
          \c_@@_margin_cover_dim ,
          \c_@@_margin_footer_dim - \paperheight
        }
      \draw_path_grid:nnnn
        { \c_@@_grid_column_width_dim + \c_@@_grid_column_sep_dim }
        { \c_@@_page_height_std_dim }
        { 0pt , 0pt }
        { \c_@@_page_width_dim - \c_@@_grid_column_width_dim ,
          \c_@@_page_height_std_dim }
      \draw_transform_shift:n
        { \c_@@_grid_column_width_dim , 0pt }
      \draw_path_grid:nnnn
        { \c_@@_grid_column_width_dim + \c_@@_grid_column_sep_dim }
        { \c_@@_page_height_std_dim }
        { 0pt , 0pt }
        { \c_@@_page_width_dim - \c_@@_grid_column_width_dim ,
          \c_@@_page_height_std_dim }
      \draw_path_use_clear:n { stroke }
    \draw_end:
  }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\@@_grid_draw_horizontal_cover:}
%   Draw horizontal grid lines for cover slide layouts.
%    \begin{macrocode}
\cs_new_protected:Nn \@@_grid_draw_horizontal_cover:
  {
    \draw_begin:
      \@@_grid_draw_set_up:
      \draw_transform_shift:n
        {
          \c_@@_margin_cover_dim ,
          \c_@@_margin_cover_dim - \paperheight
        }
      \draw_path_grid:nnnn
        { \c_@@_page_width_dim }
        { \c_@@_grid_row_cover_dim }
        { 0pt , 0pt }
        { \c_@@_page_width_dim , \c_@@_page_height_cover_dim }
      \draw_path_use_clear:n { stroke }
    \draw_end:
  }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\@@_grid_draw_horizontal_std:}
%   Draw horizontal grid lines for standard slide layouts.
%    \begin{macrocode}
\cs_new_protected:Nn \@@_grid_draw_horizontal_std:
  {
    \draw_begin:
      \@@_grid_draw_set_up:
      \draw_transform_shift:n
        {
          \c_@@_margin_cover_dim ,
          \c_@@_margin_footer_dim - \paperheight
        }
      \draw_path_grid:nnnn
        { \c_@@_page_width_dim }
        { \c_@@_grid_row_std_dim }
        { 0pt , 0pt }
        { \c_@@_page_width_dim , \c_@@_page_height_std_dim }
      \draw_path_use_clear:n { stroke }
    \draw_end:
  }
%    \end{macrocode}
% \end{macro}
%
% Set up sockets, plugs and code to the |shipout/foreground| hook to draw the
% grid if required.
%
%    \begin{macrocode}
\socket_new:nn { talkau / grid } { 0 }
\socket_new_plug:nnn { talkau / grid } { cover }
  {
    \@@_grid_draw_vertical_cover:
    \@@_grid_draw_horizontal_cover:
  }
\socket_new_plug:nnn { talkau / grid } { std }
  {
    \@@_grid_draw_vertical_std:
    \@@_grid_draw_horizontal_std:
  }
\socket_assign_plug:nn { talkau / grid } { std }
\hook_gput_code:nnn { shipout / foreground } { . }
  {
    \bool_if:NT \l_@@_grid_bool
      {
        \socket_use:nn { talkau / grid }
      }
  }
%    \end{macrocode}
%
% \subsubsection{Grid placement}
%
% The following functions calculate coordinates in \TeX{} points separated by
% commas from grid positions. These functions are expandable.
%
% \begin{macro}{\@@_grid_x:nn}
%   Convert a grid cell $x$ position to a value suitable for a |picture|
%   environment \cs{put} command.
%   \begin{arguments}
%     \item $x$ grid cell position (|l| \textbar{} |c| \textbar{} |r|
%       \textbar{} |fraction|)
%     \item $x$ grid cell number (1–12)
%   \end{arguments}
%    \begin{macrocode}
\cs_new:Nn \@@_grid_x:nn
  {
    \dim_eval:n
      {
        \c_@@_margin_cover_dim + 
        \int_eval:n { #2 - 1 } \c_@@_grid_column_width_dim +
        \int_eval:n { #2 - 1 } \c_@@_grid_column_sep_dim +
        \str_case:nnF {#1}
          {
            { l } { 0 }
            { c } { 0.5 }
            { r } { }
          }
          {#1}
        \c_@@_grid_column_width_dim
      }
  }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\@@_grid_y:nn}
%   Convert a grid cell $y$ position to a value suitable for a |picture|
%   environment \cs{put} command.
%   \begin{arguments}
%     \item $y$ grid cell position (|b| \textbar{} |c| \textbar{} |t|
%       \textbar{} |fraction|)
%     \item $y$ grid cell number (1–18 for std layout and 1–12 for cover
%       layout)
%   \end{arguments}
%    \begin{macrocode}
\cs_new:Nn \@@_grid_y:nn
  {
    \bool_if:NTF \g_@@_frame_design_grid_cover_bool
      {
        \dim_eval:n
          {
            - \paperheight +
             \c_@@_margin_cover_dim +
            \int_eval:n { #2 - 1 } \c_@@_grid_row_cover_dim +
            \str_case:nnF {#1}
              {
                { b } { 0 }
                { c } { 0.5 }
                { t } { }
              }
              {#1}
            \c_@@_grid_row_cover_dim
          }
      }
      {
        \dim_eval:n
          {
            - \paperheight +
            \c_@@_margin_footer_dim +
            \int_eval:n { #2 - 1 } \c_@@_grid_row_std_dim +
            \str_case:nnF {#1}
              {
                { b } { 0 }
                { c } { 0.5 }
                { t } { }
              }
              {#1}
            \c_@@_grid_row_std_dim
          }
      }
  }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\@@_grid_xy:nnnn}
%   Convert a grid cell position to to values suitable for a |picture|
%   environment \cs{put} command.
%   \begin{arguments}
%     \item $x$ grid cell position (|l| \textbar{} |c| \textbar{} |r|
%       \textbar{} |fraction|)
%     \item $x$ grid cell number (1–12)
%     \item $y$ grid cell position (|b| \textbar{} |m| \textbar{} |t|
%       \textbar{} |fraction|)
%     \item $y$ grid cell number (1–18 for std layout and 1–12 for cover
%       layout)
%   \end{arguments}
%    \begin{macrocode}
\cs_new:Nn \@@_grid_xy:nnnn
  {
    \@@_grid_x:nn {#1} {#2} , \@@_grid_y:nn {#3} {#4}
  }
%    \end{macrocode}
% \end{macro}
%   
% \begin{macro}{\@@_grid_rect:nnnnnnnn}
%   Convert a grid cell rectangle to values suitable for a |picture|
%   environment \cs{put} command.
%   \begin{arguments}
%     \item Bottom left $x$ grid cell position (|l| \textbar{} |c| \textbar{}
%       |r| \textbar{} |fraction|)
%     \item Bottom left $x$ grid cell number (1–12)
%     \item Bottom left $y$ grid cell position (|b| \textbar{} |c| \textbar{}
%       |t| \textbar{} |fraction|)
%     \item Bottom left $y$ grid cell number (1–18 for std layout and 1–12 for
%       cover layout)
%     \item Top right $x$ grid cell position (|l| \textbar{} |c| \textbar{}
%       |r| \textbar{} |fraction|)
%     \item Top right $x$ grid cell number (1–12)
%     \item Top right $y$ grid cell position (|b| \textbar{} |c| \textbar{}
%       |t| \textbar{} |fraction|)
%     \item Top right $y$ grid cell number (1–18 for std layout and 1–12 for
%       cover layout)
%   \end{arguments}
%    \begin{macrocode}
\cs_new:Nn \@@_grid_rect:nnnnnnnn
  {
    \@@_grid_x:nn {#1} {#2} , \@@_grid_y:nn {#3} {#4} ,
    \@@_grid_x:nn {#5} {#6} , \@@_grid_y:nn {#7} {#8} ,
  }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\@@_grid_dx:nnn}
%   Calculate the distance between the left-hand side of |#2| and the
%   right-hand side of |#3| in points. If |#1| is |true| then calculate the
%   distance between the centre of the cells.
%   \begin{arguments}
%     \item Set to |true| to calculate the distance from the centre of the
%       cells
%     \item Left-hand $x$ grid cell number (1–12)
%     \item Right-hand $x$ grid cell number (1–12)
