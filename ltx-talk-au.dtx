%
%    \begin{macrocode}
\NewTemplateType { section-frame } { 1 }
\DeclareTemplateInterface { section-frame } { talkau } { 1 }
  {
    , numbered : boolean   = true
    , theme    : tokenlist = std
  }
\DeclareTemplateCode { section-frame } { talkau } { 1 }
  {
    , numbered = \l_@@_section_frame_numbered_bool
    , theme    = \l_@@_section_frame_theme_tl
  }
  {
    \SetKnownTemplateKeys { section-frame } { talkau } {#1}
    \use:e
      {
        \exp_not:N \begin { frame }
            [
              , tag-slides = 0
              , design     = section
              , theme      = \l_@@_section_frame_theme_tl
            ]
      }
      \int_compare:nNnT { \c@section } < { 10 } { 0 }
      \thesection
      \par
      \skip_vertical:n { 0.25 \c_@@_grid_row_std_dim }
      \skip_set:Nn \leftskip
        {
          \TalkAUx [ 0.2 ] { 2 } - \TalkAUx [ l ] { 1 }
        }
      \l__talk_section_tl
    \end { frame }
  }
