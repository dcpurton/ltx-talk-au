% \subsection{Fonts}
%
%    \begin{macrocode}
\clist_new:N \l_@@_options_clist
\clist_set:Nn \l_@@_options_clist { font-size = 10pt }
\keys_define:nn { talkau }
  {
    , testnational2 .bool_set:N       = \l_@@_use_testnational_font_bool
    , testnational2 .value_required:n = false
    , testnational2 .default:n        = true
    , testnational2 .initial:n        = false
    , unknown       .code:n           = \clist_put_right:NV
                                          \l_@@_options_clist
                                          \CurrentOption
  }
\ProcessKeyOptions [ talkau ]
\exp_args:NV \PassOptionsToClass \l_@@_options_clist { ltx-talk }
\LoadClass { ltx-talk }
%    \end{macrocode}
%
% Always use Roboto Serif for body font since this font is in \TeX Live. Use
% Stix 2 for maths.  Heading font is more complicated. Use National 2
% Condensed if available, otherwise fall back to Barlow Condensed (you'll need
% to download and install this font).  For testing, a test version of National
% 2 Condensed with limited character support and no OpenType features exists.
% \pkg{ltx-talk-au} can be instructed to use this font, falling back to Barlow
% Condensed for missing characters.
%
%    \begin{macrocode}
\RequirePackage { fontspec }
\ExplSyntaxOff
\directlua{
  luaotfload.add_fallback("barlow-medium", {
    "BarlowCondensedMedium:mode=node;"
  })
  luaotfload.add_fallback("barlow-bold", {
    "BarlowCondensedBold:mode=node;"
  })
}
\ExplSyntaxOn
\setmainfont { Roboto ~ Serif }
\fontspec_font_if_exist:nTF { National2Condensed-Medium.otf }
  {
    \setsansfont { National2Condensed-Medium.otf }
      [
        , ItalicFont     = TestNational2Condensed-MediumItalic.otf
        , BoldFont       = TestNational2Condensed-Bold.otf
        , BoldItalicFont = TestNational2Condensed-BoldItalic.otf
      ]
  }
  {
    \bool_if:NTF \l_@@_use_testnational_font_bool
      {
        \setsansfont { TestNational2Condensed-Medium.otf }
          [
            , RawFeature     = { fallback = barlow-medium }
            , ItalicFont     = BarlowCondensed-MediumItalic.ttf
            , BoldFont       = TestNational2Condensed-Bold.otf
            , BoldFeatures   = { RawFeature = { fallback = barlow-bold } }
            , BoldItalicFont = BarlowCondensed-BoldItalic.ttf
          ]
      }
      {
        \setsansfont { BarlowCondensed-Medium.ttf }
          [
            , ItalicFont     = BarlowCondensed-MediumItalic.ttf
            , BoldFont       = BarlowCondensed-Bold.ttf
            , BoldItalicFont = BarlowCondensed-BoldItalic.ttf
          ]
      }
  }
\setmathfont { STIX ~ Two ~ Math } [ Scale = MatchLowercase ]
\setmathrm { Roboto ~ Serif }
%    \end{macrocode}
%
% \begin{macro}{\@@_font_capheight_to_size:n}
%   Return the point size required to select a font with specified capital X
%   height.
%   \begin{arguments}
%     \item Desired height of capital X in current font family.
%   \end{arguments}
%    \begin{macrocode}
\cs_new:Nn \@@_font_capheight_to_size:n
  {
    \fp_to_decimal:n
      {
        \dim_to_decimal:n {#1} *
        \f@size /
        \dim_to_decimal:n { \fontcharht \font ` X }
      }
    pt
  }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\@@_fontsize_from_capheight:nn}
%   Select a font size with leading ratio from specified capital X height.
%   \begin{arguments}
%     \item Desired height of capital X in current font family.
%     \item Desired leading ratio.
%   \end{arguments}
%    \begin{macrocode}
\cs_new:Nn \@@_fontsize_from_capheight:nn
  {
    \exp_args:Nee
      \fontsize
        { \@@_font_capheight_to_size:n {#1} }
        {
          \dim_eval:n { \@@_font_capheight_to_size:n {#1} * #2 }
        }
    \selectfont
  }
%    \end{macrocode}
% \end{macro}
