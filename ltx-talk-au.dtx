%
% Set up a |frame-image| template for formatting background images.
%
%    \begin{macrocode}
\tl_new:N \l_@@_frame_image_slot_tl
\NewTemplateType { frame-image } { 1 }
\DeclareTemplateInterface { frame-image } { talkau } { 1 }
  {
    , slot           : choice { a , b , bg } = a
    , image-filename : tokenlist
    , offset         : commalist = { 0pt , 0pt }
    , alt            : tokenlist
    , artifact       : boolean
  }
\DeclareTemplateCode { frame-image } { talkau } { 1 }
  {
    , slot =
        {
          , a  = \tl_set:Nn \l_@@_frame_image_slot_tl { a }
          , b  = \tl_set:Nn \l_@@_frame_image_slot_tl { b }
          , bg = \tl_set:Nn \l_@@_frame_image_slot_tl { bg }
        }
    , image-filename = \l_@@_frame_image_filename_tl
    , offset         = \l_@@_frame_image_offset_clist
    , alt            = \l_@@_frame_image_alt_tl
    , artifact       = \l_@@_frame_image_artifact_bool
  }
  {
    \SetKnownTemplateKeys { frame-image } { talkau } {#1}
    \clist_set:Ne \l_tmpa_clist
      {
        \tl_use:c
          {
            g_@@_frame_design_image_
              \l_@@_frame_image_slot_tl
                _area_tl
          }
      }
    \clist_if_empty:NF \l_tmpa_clist
      {
        \bool_if:NTF \l_@@_frame_image_artifact_bool
          {
            \@@_image_fill_area:nnnnnnnn
              { \clist_item:Nn \l_tmpa_clist { 1 } }
              { \clist_item:Nn \l_tmpa_clist { 2 } }
              { \clist_item:Nn \l_tmpa_clist { 3 } }
              { \clist_item:Nn \l_tmpa_clist { 4 } }
              { \clist_item:Nn \l_@@_frame_image_offset_clist { 1 } }
              { \clist_item:Nn \l_@@_frame_image_offset_clist { 2 } }
              { artifact }
              { \l_@@_frame_image_filename_tl }
          }
          {
            \UseTaggingSocket { talkau / background / figure / begin }
            \@@_image_fill_area:nnnnnnnn
              { \clist_item:Nn \l_tmpa_clist { 1 } }
              { \clist_item:Nn \l_tmpa_clist { 2 } }
              { \clist_item:Nn \l_tmpa_clist { 3 } }
              { \clist_item:Nn \l_tmpa_clist { 4 } }
              { \clist_item:Nn \l_@@_frame_image_offset_clist { 1 } }
              { \clist_item:Nn \l_@@_frame_image_offset_clist { 2 } }
              { alt = \l_@@_frame_image_alt_tl }
              { \l_@@_frame_image_filename_tl }
            \UseTaggingSocket { talkau / background / figure / end }
          }
      }
  }
