% \subsubsection{Background images}
%
% Background images need to be tagged as figures and inserted into the
% previous frame structure. Set up tagging sockets to surround images with the
% following structure:
% \begin{quote}
%   \ttfamily
%   text-unit \\
%   \pmboxdrawuni{2514}\pmboxdrawuni{2500}Div \\
%   |  |\pmboxdrawuni{2514}\pmboxdrawuni{2500}float
% \end{quote}
% The |parent| of the |text-unit| is set to \cs{g__talk_frame_struct_int} in
% order to insert the figure into the current frame structure.
%
%    \begin{macrocode}
\NewTaggingSocket { talkau / background / figure / begin } { 0 }
\NewTaggingSocket { talkau / background / figure / end } { 0 }
\NewTaggingSocketPlug { talkau / background / figure / begin } { default }
  {
    \tag_struct_begin:n
      {
        , tag    = text-unit
        , parent = \int_use:N \g__talk_frame_struct_int
      }
      \tag_struct_begin:n { tag = Div }
        \tag_struct_begin:n { tag = float }
  }
\NewTaggingSocketPlug { talkau / background / figure / end } { default }
  {
        \tag_struct_end:
      \tag_struct_end:
    \tag_struct_end:
  }
\AssignTaggingSocketPlug { talkau / background / figure / begin } { default }
\AssignTaggingSocketPlug { talkau / background / figure / end } { default }
%    \end{macrocode}
