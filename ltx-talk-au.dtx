    , b        .value_forbidden:n = true
    , bg       .meta:n            = { slot = bg }
    , bg       .value_forbidden:n = true
    , slot     .choices:nn        = { a , b , bg }
                                    {
                                      \str_set_eq:NN
                                        \l_@@_frame_image_slot_str
